# Copy to deploy/.env and edit. docker compose reads this automatically.

# Required: bearer token for every route except /health (the Pi extension and
# MCP clients send it; /health stays open so container probes need no secret).
AVP_DAEMON_TOKEN=change-me

# Default model used when a tool call omits `model`.
AVP_DEFAULT_MODEL=Qwen/Qwen2.5-7B-Instruct

# Registry sizing.
AVP_MAX_CONTEXTS=8
AVP_TTL=300

# Host-side bind address. Keep 127.0.0.1 unless a reverse proxy adds auth.
AVP_BIND_ADDR=127.0.0.1

# Base image. Use a CUDA + torch image for GPU, e.g.
#   AVP_BASE_IMAGE=pytorch/pytorch:2.4.0-cuda12.4-cudnn9-runtime
AVP_BASE_IMAGE=python:3.12-slim

# Torch wheel index for the CPU build (keeps the image small). The GPU override
# clears this because the CUDA base already ships torch.
AVP_TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu

# Optional: Hugging Face token for gated models.
# HF_TOKEN=hf_...
