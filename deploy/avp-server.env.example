# /etc/avp/avp-server.env — environment for the avp-server systemd unit.
# Install with: sudo install -m 600 -o root -g root avp-server.env.example /etc/avp/avp-server.env

# Bearer token required on every route except /health (the Pi extension sends it;
# /health stays open for probes).
AVP_DAEMON_TOKEN=change-me

# Optional Hugging Face token for gated models.
# HF_TOKEN=hf_...

# CLI arguments for `avp-server`, split on whitespace.
# Keep --host on 127.0.0.1 unless a reverse proxy provides auth.
# Device is auto-detected (cuda > mps > cpu); add `--device cuda` to force it.
AVP_SERVER_ARGS=--host 127.0.0.1 --port 8765 --default-model Qwen/Qwen2.5-7B-Instruct --max-contexts 8 --ttl 300

# Example: run a local GGUF on CPU (4 GB VRAM, 4.8 GB model). --n-gpu-layers 0
# keeps all layers on CPU; raise it to offload what fits. --n-ctx caps the
# context window.
# AVP_SERVER_ARGS=--host 127.0.0.1 --port 8765 --backend llamacpp --default-model /models/Ling-3.0-tiny-Q4_K_M.gguf --n-gpu-layers 0 --n-ctx 2048

# Example: preload both models used by a cross-model pipeline and restrict the
# set of loadable models.
# AVP_SERVER_ARGS=--host 127.0.0.1 --port 8765 --device cuda --max-contexts 8 --preload Qwen/Qwen2.5-7B-Instruct,meta-llama/Llama-3.2-3B-Instruct --allowed-models Qwen/Qwen2.5-7B-Instruct,meta-llama/Llama-3.2-3B-Instruct
